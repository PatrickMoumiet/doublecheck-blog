---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'] & { slug?: string };

const { title, seoTitle, description, pubDate, updatedDate, heroImage, authorName, authorImage, toc, faq, slug, noindex } =
	Astro.props;

// Stop words for topic similarity calculation
const stopWords = new Set([
	'a', 'an', 'the', 'and', 'or', 'but', 'in', 'on', 'at', 'to', 'for', 'of', 'with', 'by',
	'from', 'up', 'about', 'into', 'over', 'after', 'is', 'are', 'was', 'were', 'be', 'been',
	'how', 'what', 'why', 'who', 'which', 'this', 'that', 'these', 'those', 'your', 'you',
	'we', 'our', 'their', 'they', 'it', 'its', 'as'
]);

function extractKeywords(text: string): Set<string> {
	return new Set(
		text
			.toLowerCase()
			.replace(/[^a-z0-9\s]/g, ' ')
			.split(/\s+/)
			.filter((word) => word.length > 2 && !stopWords.has(word))
	);
}

const currentKeywords = extractKeywords(`${title} ${description}`);

const allPosts = await getCollection('blog');
const otherPosts = allPosts.filter((p) => p.id !== slug);

// Score other posts by keyword overlap for topic similarity
const scoredPosts = otherPosts.map((p) => {
	const otherKeywords = extractKeywords(`${p.data.title} ${p.data.description}`);
	let overlap = 0;
	for (const word of currentKeywords) {
		if (otherKeywords.has(word)) {
			overlap++;
		}
	}
	return { post: p, score: overlap };
});

scoredPosts.sort((a, b) => {
	if (b.score !== a.score) {
		return b.score - a.score;
	}
	return b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf();
});

const related = scoredPosts.slice(0, 3).map((item) => item.post);

// Contextual product recommendation linking to non-www main site
const lowerContent = `${title} ${description} ${slug ?? ''}`.toLowerCase();
const isTemplateTopic =
	lowerContent.includes('template') ||
	lowerContent.includes('incorporat') ||
	lowerContent.includes('draft') ||
	lowerContent.includes('launch') ||
	lowerContent.includes('playbook') ||
	lowerContent.includes('startup');

const productCta = isTemplateTopic
	? {
			url: 'https://contactdoublecheck.com/generate-template',
			badge: 'AI Legal Drafting',
			heading: 'Draft Tailored Legal Documents with AI',
			body: 'Create customized contracts, startup formation documents, and business agreements in minutes with DoubleCheck Legal’s AI agent, then have them verified by licensed attorneys.',
			anchorText: 'Draft with DoubleCheck Legal →',
	  }
	: {
			url: 'https://contactdoublecheck.com/marketplace',
			badge: 'Attorney Verification',
			heading: 'Need an Attorney to Review Your Work?',
			body: 'AI drafts fast, but legal enforceability requires licensed human review. Connect with vetted attorneys specializing in AI contracts and business law on DoubleCheck Legal.',
			anchorText: 'Find a Reviewing Attorney on DoubleCheck →',
	  };

const postUrl = new URL(Astro.url.pathname, Astro.site).toString();
const imageUrl = heroImage ? new URL(heroImage.src, Astro.site).toString() : undefined;

// Structured data for search and AI answer engines (GEO):
// Article metadata + BreadcrumbList + FAQPage schema
const articleSchema = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	mainEntityOfPage: {
		'@type': 'WebPage',
		'@id': postUrl,
	},
	headline: title,
	description: description,
	...(imageUrl && { image: imageUrl }),
	datePublished: pubDate.toISOString(),
	...(updatedDate && { dateModified: updatedDate.toISOString() }),
	...(authorName && { author: { '@type': 'Person', name: authorName } }),
	publisher: {
		'@type': 'Organization',
		name: 'DoubleCheck Legal',
		url: 'https://contactdoublecheck.com',
		logo: {
			'@type': 'ImageObject',
			url: 'https://contactdoublecheck.com/favicon.png',
		},
	},
};

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{
			'@type': 'ListItem',
			position: 1,
			name: 'Home',
			item: 'https://contactdoublecheck.com',
		},
		{
			'@type': 'ListItem',
			position: 2,
			name: 'Blog',
			item: 'https://blog.contactdoublecheck.com/blog',
		},
		{
			'@type': 'ListItem',
			position: 3,
			name: title,
			item: postUrl,
		},
	],
};

const faqSchema = faq && faq.length > 0 && {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faq.map((item) => ({
		'@type': 'Question',
		name: item.question,
		acceptedAnswer: {
			'@type': 'Answer',
			text: item.answer,
		},
	})),
};
---

<html lang="en">
	<head>
		<BaseHead title={seoTitle ?? title} description={description} image={heroImage} type="article" noindex={noindex} />
		<script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
		{faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.byline {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 0.6em;
				margin-bottom: 1em;
				text-align: left;
			}
			.byline img {
				width: 36px;
				height: 36px;
				border-radius: 50%;
				object-fit: cover;
				margin: 0;
				border: none;
			}
			.byline .byline-text {
				line-height: 1.3;
			}
			.byline .byline-label {
				display: block;
				font-size: 0.75em;
				text-transform: uppercase;
				letter-spacing: 0.05em;
				color: rgb(var(--gray));
			}
			.byline .byline-name {
				display: block;
				font-weight: 600;
				color: rgb(var(--black));
			}
			.toc {
				border: 1px solid rgb(var(--gray-light));
				border-radius: 6px;
				padding: 1.2em 1.4em;
				margin: 0 0 2em 0;
				background: var(--card-bg);
			}
			.toc-label {
				display: block;
				font-size: 0.75em;
				font-weight: 600;
				text-transform: uppercase;
				letter-spacing: 0.06em;
				color: var(--accent);
				margin-bottom: 0.6em;
			}
			.toc ul {
				margin: 0;
				padding: 0;
				list-style: none;
				columns: 2;
				column-gap: 1.5em;
			}
			.toc li {
				margin-bottom: 0.5em;
				break-inside: avoid;
			}
			.toc a {
				text-decoration: none;
				font-size: 0.95em;
			}
			.toc a:hover {
				color: var(--accent-dark);
			}
			@media (max-width: 600px) {
				.toc ul {
					columns: 1;
				}
			}
			.related {
				margin-top: 3em;
				padding-top: 1em;
				border-top: 1px solid rgb(var(--gray-light));
			}
			.related ul {
				padding-left: 1.2em;
			}
			.related li {
				margin-bottom: 0.5em;
			}
			.last-updated-on {
				font-style: italic;
			}
			.contextual-cta {
				margin: 3em 0 2em;
				padding: 1.5em;
				background: var(--card-bg);
				border: 1px solid var(--accent);
				border-radius: 8px;
			}
			.cta-badge {
				display: inline-block;
				font-size: 0.72em;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.08em;
				color: var(--accent);
				margin-bottom: 0.4em;
			}
			.cta-heading {
				margin: 0 0 0.5em 0;
				font-size: 1.25em;
				color: rgb(var(--black));
			}
			.cta-body {
				margin: 0 0 1.2em 0;
				font-size: 0.95em;
				line-height: 1.5;
				color: rgb(var(--gray-dark));
			}
			.cta-link {
				display: inline-block;
				font-weight: 600;
				font-size: 0.95em;
				color: #ffffff;
				background: var(--accent);
				padding: 0.6em 1.2em;
				border-radius: 6px;
				text-decoration: none;
				transition: background 0.15s ease;
			}
			.cta-link:hover {
				background: var(--accent-dark);
				color: #ffffff;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						{
							authorName && (
								<div class="byline">
									{authorImage && <img src={authorImage} alt={authorName} />}
									<span class="byline-text">
										<span class="byline-label">Written by</span>
										<span class="byline-name">{authorName}</span>
									</span>
								</div>
							)
						}
						<hr />
					</div>
					{
						toc && toc.length > 0 && (
							<nav class="toc">
								<span class="toc-label">In this report</span>
								<ul>
									{toc.map((item) => (
										<li>
											<a href={`#${item.anchor}`}>{item.label}</a>
										</li>
									))}
								</ul>
							</nav>
						)
					}
					<slot />
					<aside class="contextual-cta">
						<span class="cta-badge">{productCta.badge}</span>
						<h3 class="cta-heading">{productCta.heading}</h3>
						<p class="cta-body">{productCta.body}</p>
						<a href={productCta.url} class="cta-link" target="_blank" rel="noopener">
							{productCta.anchorText}
						</a>
					</aside>
					{
						related.length > 0 && (
							<aside class="related">
								<h2>Related articles</h2>
								<ul>
									{related.map((p) => (
										<li>
											<a href={`/blog/${p.id}/`}>{p.data.title}</a>
										</li>
									))}
								</ul>
							</aside>
						)
					}
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
