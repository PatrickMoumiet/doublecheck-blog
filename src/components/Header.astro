---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2>
			<a href="/">
				<img class="logo-ring" src="/logo.png" alt="" width="26" height="26" />
				<span>{SITE_TITLE}</span>
			</a>
		</h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/learning">Learning</HeaderLink>
		</div>
		<div class="social-links">
			<a href="https://www.linkedin.com/company/doublechecklegal/" target="_blank">
				<span class="sr-only">DoubleCheck Legal on LinkedIn</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="20" height="20"
					><path
						fill="currentColor"
						d="M13.5 0h-11A2.5 2.5 0 0 0 0 2.5v11A2.5 2.5 0 0 0 2.5 16h11a2.5 2.5 0 0 0 2.5-2.5v-11A2.5 2.5 0 0 0 13.5 0zM5 13H3V6h2v7zM4 5a1.15 1.15 0 1 1 0-2.3A1.15 1.15 0 0 1 4 5zm9 8h-2V9.5c0-.9-.3-1.5-1.1-1.5a1.2 1.2 0 0 0-1.1.8 1.5 1.5 0 0 0-.1.5V13H7s.03-6.4 0-7h2v1a2 2 0 0 1 1.8-1c1.3 0 2.2.9 2.2 2.7V13z"
					></path></svg
				>
			</a>
			<a href="https://www.instagram.com/doublechecklegal" target="_blank">
				<span class="sr-only">DoubleCheck Legal on Instagram</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="20" height="20"
					><path
						fill="currentColor"
						d="M8 0C5.8 0 5.5 0 4.7.05a5.9 5.9 0 0 0-1.95.37A4 4 0 0 0 .42 2.75a5.9 5.9 0 0 0-.37 1.95C0 5.5 0 5.8 0 8s0 2.5.05 3.3a5.9 5.9 0 0 0 .37 1.95 4 4 0 0 0 2.33 2.33 5.9 5.9 0 0 0 1.95.37C5.5 16 5.8 16 8 16s2.5 0 3.3-.05a5.9 5.9 0 0 0 1.95-.37 4 4 0 0 0 2.33-2.33 5.9 5.9 0 0 0 .37-1.95C16 10.5 16 10.2 16 8s0-2.5-.05-3.3a5.9 5.9 0 0 0-.37-1.95A4 4 0 0 0 13.25.42a5.9 5.9 0 0 0-1.95-.37C10.5 0 10.2 0 8 0zm0 1.44c2.16 0 2.42 0 3.27.05.79.03 1.22.16 1.5.27.38.14.65.32.93.6.28.28.46.55.6.93.11.28.24.71.27 1.5.05.85.05 1.11.05 3.27s0 2.42-.05 3.27c-.03.79-.16 1.22-.27 1.5a2.5 2.5 0 0 1-.6.93c-.28.28-.55.46-.93.6-.28.11-.71.24-1.5.27-.85.05-1.11.05-3.27.05s-2.42 0-3.27-.05c-.79-.03-1.22-.16-1.5-.27a2.5 2.5 0 0 1-.93-.6 2.5 2.5 0 0 1-.6-.93c-.11-.28-.24-.71-.27-1.5C1.44 10.42 1.44 10.16 1.44 8s0-2.42.05-3.27c.03-.79.16-1.22.27-1.5.14-.38.32-.65.6-.93.28-.28.55-.46.93-.6.28-.11.71-.24 1.5-.27C5.58 1.44 5.84 1.44 8 1.44zm0 2.45a4.11 4.11 0 1 0 0 8.22 4.11 4.11 0 0 0 0-8.22zm0 6.78a2.67 2.67 0 1 1 0-5.34 2.67 2.67 0 0 1 0 5.34zm5.23-6.94a.96.96 0 1 1-1.92 0 .96.96 0 0 1 1.92 0z"
					></path></svg
				>
			</a>
			<a href="https://www.tiktok.com/@doublechecklegal" target="_blank">
				<span class="sr-only">DoubleCheck Legal on TikTok</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="20" height="20"
					><path
						fill="currentColor"
						d="M9.4 0h2.1s-.12 3.24 3.5 3.49v2.13s-1.96.12-3.5-.95v5.34a4.53 4.53 0 1 1-3.9-4.5v2.2a2.34 2.34 0 1 0 1.8 2.28V0z"
					></path></svg
				>
			</a>
			<a href="https://x.com/doublecheckai" target="_blank">
				<span class="sr-only">DoubleCheck Legal on X</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="20" height="20"
					><path
						fill="currentColor"
						d="M12.6.75h2.45l-5.36 6.13L16 15.25h-4.94l-3.87-5.06-4.43 5.06H.3l5.73-6.55L0 .75h5.06l3.5 4.63L12.6.75zm-.86 13.03h1.36L4.32 2.15H2.86l8.88 11.63z"
					></path></svg
				>
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1.5em;
		background: #ffffff;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	h2 {
		margin: 0;
		font-size: 0.95em;
	}
	h2 a {
		display: flex;
		align-items: center;
		gap: 0.5em;
		text-decoration: none;
		color: rgb(var(--black));
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}
	.logo-ring {
		flex-shrink: 0;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1em;
	}
	.internal-links {
		display: flex;
	}
	nav .internal-links a {
		padding: 1.1em 0.9em;
		color: rgb(var(--gray-dark));
		border-bottom: 2px solid transparent;
		text-decoration: none;
		font-size: 0.85em;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}
	nav .internal-links a.active {
		color: var(--accent);
		border-bottom-color: var(--accent);
	}
	.social-links {
		display: flex;
		gap: 0.6em;
	}
	.social-links a {
		display: flex;
		color: rgb(var(--gray));
	}
	.social-links a:hover {
		color: var(--accent);
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
	}
</style>
