---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 6);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.intro {
				max-width: 720px;
				margin: 3rem auto 3.5rem auto;
				padding: 0 1rem;
			}
			.intro p {
				color: rgb(var(--gray));
				font-size: 1.1rem;
				max-width: 560px;
			}
			.section-header {
				max-width: 960px;
				margin: 0 auto;
				padding: 0 1rem;
				display: flex;
				align-items: baseline;
				justify-content: space-between;
			}
			.section-header h2 {
				margin-bottom: 1.2rem;
			}
			.view-all-link {
				font-size: 0.85em;
				font-weight: 600;
				text-transform: uppercase;
				letter-spacing: 0.04em;
				text-decoration: none;
			}
			.post-grid {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 1.25rem;
				list-style-type: none;
				margin: 0 auto 3rem auto;
				padding: 0 1rem;
				max-width: 960px;
			}
			.post-card {
				border: 1px solid rgb(var(--gray-light));
				border-radius: 6px;
				background: #ffffff;
				transition: 0.15s ease;
			}
			.post-card:hover {
				border-color: var(--accent);
				box-shadow: var(--box-shadow);
			}
			.post-card a {
				display: block;
				padding: 1.4rem;
				text-decoration: none;
			}
			.post-card .date {
				display: block;
				font-size: 0.75em;
				font-weight: 600;
				text-transform: uppercase;
				letter-spacing: 0.06em;
				color: var(--accent);
				margin-bottom: 0.6rem;
			}
			.post-card .title {
				margin: 0;
				color: rgb(var(--black));
				font-size: 1.05rem;
				line-height: 1.4;
			}
			.post-card:hover .title {
				color: var(--accent);
			}
			@media (max-width: 720px) {
				.post-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="intro">
				<span class="eyebrow">Research &amp; Insights</span>
				<h1>DoubleCheck Legal</h1>
				<p>
					Data and analysis on how businesses use AI to draft legal work, and where professional
					review still matters.
				</p>
			</div>

			<div class="section-header">
				<h2>Latest posts</h2>
				<a class="view-all-link" href="/blog">View all →</a>
			</div>
			<ul class="post-grid">
				{
					posts.map((post) => (
						<li class="post-card">
							<a href={`/blog/${post.id}/`}>
								<span class="date">
									<FormattedDate date={post.data.pubDate} />
								</span>
								<h4 class="title">{post.data.title}</h4>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
